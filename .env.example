# Скопируйте в .env (для docker compose) или backend/.env (для локального запуска).

# PAT команды SourceCraft: нужен для каталога открытых репозиториев и публичных данных API
# (без токена API отвечает 401 даже на GET /repos). Без него сервис работает в режиме «только git».
SOURCECRAFT_SERVICE_PAT=

# OAuth-приложение Я ID (https://oauth.yandex.ru/client/new), redirect URI - ниже.
YA_ID_CLIENT_ID=
YA_ID_CLIENT_SECRET=
YA_ID_REDIRECT_URI=http://localhost:8080/api/v1/auth/yandex/callback
FRONTEND_URL=http://localhost:8080
# Вход без Я ID для локальной проверки. В продакшене - false.
DEV_LOGIN_ENABLED=false

# Подпись сессий и шифрование PAT пользователей. Обязательно смените: openssl rand -hex 32
SECRET_KEY=change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080

# Лимиты частоты (организаторы: appsec - 100 rps, остальные хосты - 10 rps на каждый).
SOURCECRAFT_API_RPS=8
APPSEC_API_RPS=50

# Расписание пересчёта (cron, UTC) и минимальный интервал между пересчётами репозитория.
SCHEDULE_CRON=0 3 * * *
RECALC_INTERVAL_HOURS=24
WORKER_CONCURRENCY=2
